{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Queues",
      "Effect": "Allow",
      "Action": "sqs:*",
      "Resource": "arn:aws:sqs:REGION:ACCOUNT:PREFIX*"
    },
    {
      "Sid": "Secrets",
      "Effect": "Allow",
      "Action": "secretsmanager:*",
      "Resource": "arn:aws:secretsmanager:REGION:ACCOUNT:secret:PREFIX*"
    },
    {
      "Sid": "ImageRegistry",
      "Effect": "Allow",
      "Action": "ecr:*",
      "Resource": "arn:aws:ecr:REGION:ACCOUNT:repository/PREFIX*"
    },
    {
      "Sid": "Buckets",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::PREFIX*",
        "arn:aws:s3:::PREFIX*/*"
      ]
    },
    {
      "Sid": "FunctionsNotExercisedByCi",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": "arn:aws:lambda:REGION:ACCOUNT:function:PREFIX*"
    },
    {
      "Sid": "FunctionExecutionRoleNotExercisedByCi",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT:role/EXECUTION-ROLE-NAME",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DatabasesNotExercisedByCi",
      "Effect": "Allow",
      "Action": "rds:*",
      "Resource": [
        "arn:aws:rds:REGION:ACCOUNT:db:PREFIX*",
        "arn:aws:rds:REGION:ACCOUNT:subgrp:PREFIX*",
        "arn:aws:rds:REGION:ACCOUNT:pg:PREFIX*"
      ]
    },
    {
      "Sid": "KubernetesClustersNotExercisedByCi",
      "Effect": "Allow",
      "Action": "eks:*",
      "Resource": [
        "arn:aws:eks:REGION:ACCOUNT:cluster/PREFIX*",
        "arn:aws:eks:REGION:ACCOUNT:nodegroup/PREFIX*/*/*"
      ]
    },
    {
      "Sid": "KubernetesRolesNotExercisedByCi",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::ACCOUNT:role/EKS-CLUSTER-ROLE-NAME",
        "arn:aws:iam::ACCOUNT:role/EKS-NODE-ROLE-NAME"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "eks.amazonaws.com",
            "ec2.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "KubernetesReadRolesNotExercisedByCi",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": [
        "arn:aws:iam::ACCOUNT:role/EKS-CLUSTER-ROLE-NAME",
        "arn:aws:iam::ACCOUNT:role/EKS-NODE-ROLE-NAME"
      ]
    },
    {
      "Sid": "KubernetesReadServiceLinkedRolesNotExercisedByCi",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": [
        "arn:aws:iam::ACCOUNT:role/aws-service-role/eks.amazonaws.com/AWSServiceRoleForAmazonEKS",
        "arn:aws:iam::ACCOUNT:role/aws-service-role/eks-nodegroup.amazonaws.com/AWSServiceRoleForAmazonEKSNodegroup"
      ]
    },
    {
      "Sid": "KubernetesServiceLinkedRolesNotExercisedByCi",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "eks.amazonaws.com",
            "eks-nodegroup.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "Ec2MutationsCannotBeNameScoped",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:RunInstances",
        "ec2:TerminateInstances",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:ModifyInstanceAttribute"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ec2:Region": "REGION"
        }
      }
    },
    {
      "Sid": "IamUsers",
      "Effect": "Allow",
      "Action": "iam:*",
      "Resource": "arn:aws:iam::ACCOUNT:user/PREFIX*"
    },
    {
      "Sid": "NeverMintUsableCredentials",
      "Effect": "Deny",
      "Action": [
        "iam:CreateAccessKey",
        "iam:UpdateAccessKey",
        "iam:CreateLoginProfile",
        "iam:UpdateLoginProfile",
        "iam:CreateServiceSpecificCredential",
        "iam:ResetServiceSpecificCredential",
        "iam:UploadSSHPublicKey",
        "iam:CreateVirtualMFADevice",
        "iam:EnableMFADevice"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadOnlyAndUnscopable",
      "Effect": "Allow",
      "Action": [
        "sqs:ListQueues",
        "secretsmanager:ListSecrets",
        "ecr:DescribeRepositories",
        "ecr:GetAuthorizationToken",
        "s3:ListAllMyBuckets",
        "ec2:Describe*",
        "lambda:ListFunctions",
        "rds:Describe*",
        "eks:ListClusters",
        "eks:DescribeCluster",
        "iam:ListUsers"
      ],
      "Resource": "*"
    }
  ]
}
