{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageTestQueuesOnly",
      "Effect": "Allow",
      "Action": [
        "sqs:CreateQueue",
        "sqs:DeleteQueue",
        "sqs:GetQueueUrl",
        "sqs:GetQueueAttributes",
        "sqs:SetQueueAttributes",
        "sqs:TagQueue"
      ],
      "Resource": "arn:aws:sqs:eu-west-1:616568506952:ci-tests-infra-*"
    },
    {
      "Sid": "ListingCannotBeScoped",
      "Effect": "Allow",
      "Action": "sqs:ListQueues",
      "Resource": "*"
    }
  ]
}
