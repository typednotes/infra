{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Queues",
      "Effect": "Allow",
      "Action": "sqs:*",
      "Resource": "arn:aws:sqs:eu-west-1:616568506952:ci-tests-infra-*"
    },
    {
      "Sid": "Secrets",
      "Effect": "Allow",
      "Action": "secretsmanager:*",
      "Resource": "arn:aws:secretsmanager:eu-west-1:616568506952:secret:ci-tests-infra-*"
    },
    {
      "Sid": "ImageRegistry",
      "Effect": "Allow",
      "Action": "ecr:*",
      "Resource": "arn:aws:ecr:eu-west-1:616568506952:repository/ci-tests-infra-*"
    },
    {
      "Sid": "Buckets",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::ci-tests-infra-*",
        "arn:aws:s3:::ci-tests-infra-*/*"
      ]
    },
    {
      "Sid": "Functions",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": "arn:aws:lambda:eu-west-1:616568506952:function:ci-tests-infra-*"
    },
    {
      "Sid": "Databases",
      "Effect": "Allow",
      "Action": "rds:*",
      "Resource": [
        "arn:aws:rds:eu-west-1:616568506952:db:ci-tests-infra-*",
        "arn:aws:rds:eu-west-1:616568506952:subgrp:ci-tests-infra-*",
        "arn:aws:rds:eu-west-1:616568506952:pg:ci-tests-infra-*"
      ]
    },
    {
      "Sid": "Ec2MutationsCannotBeNameScoped",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:RunInstances",
        "ec2:TerminateInstances",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:ModifyInstanceAttribute"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ec2:Region": "eu-west-1"
        }
      }
    },
    {
      "Sid": "IamTestUsers",
      "Effect": "Allow",
      "Action": "iam:*",
      "Resource": "arn:aws:iam::616568506952:user/ci-tests-infra-*"
    },
    {
      "Sid": "NeverMintUsableCredentials",
      "Effect": "Deny",
      "Action": [
        "iam:CreateAccessKey",
        "iam:UpdateAccessKey",
        "iam:CreateLoginProfile",
        "iam:UpdateLoginProfile",
        "iam:CreateServiceSpecificCredential",
        "iam:ResetServiceSpecificCredential",
        "iam:UploadSSHPublicKey",
        "iam:CreateVirtualMFADevice",
        "iam:EnableMFADevice"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadOnlyAndUnscopable",
      "Effect": "Allow",
      "Action": [
        "sqs:ListQueues",
        "secretsmanager:ListSecrets",
        "ecr:DescribeRepositories",
        "ecr:GetAuthorizationToken",
        "s3:ListAllMyBuckets",
        "ec2:Describe*",
        "lambda:ListFunctions",
        "rds:Describe*",
        "iam:ListUsers"
      ],
      "Resource": "*"
    }
  ]
}
